{
  "manifest_version": 3,
  "name": "AI Usage Status · Gemini 聊天额度",
  "version": "1.0.0",
  "description": "将 Gemini 聊天的当前与每周额度发送到本机菜单栏。",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://www.gstatic.com/bg3/boq-bard-web/*"
  ],
  "action": {
    "default_title": "Gemini Usage bridge",
    "default_popup": "popup.html"
  },
  "key": ""
}
